begin function { short iMenuId, short iTileId, string_var sTileName }

	; UDFs

	ref GetConfigUDF = CompileScript "SaintsMedicalIntervention\Configuration\GetConfig.gek"
	ref OnTriageSelectionConfirmUDF = CompileScript "SaintsMedicalIntervention\Activation\OnTriageSelectionConfirm.gek"
	ref PerformQuickTreatmentUDF = CompileScript "SaintsMedicalIntervention\Treatment\PerformQuickTreatment.gek"
	ref PlayInteractionSoundUDF = CompileScript "SaintsMedicalIntervention\Treatment\PlayInteractionSound.gek"
	ref GetPlayerBodyHealthMapUDF = CompileScript "SaintsMedicalIntervention\Status\GetPlayerBodyHealthMap.gek"

	; Configuration

	array_var aConfig = Call GetConfigUDF

	short iPaperDollTreatment = aConfig["iPipBoyPaperDollTreatment"]

	; Resolve Tile

	string_var sKey

	if iTileId == 1061
		let sKey := "head"
	elseif iTileId == 1063
		let sKey := "torso"
	elseif iTileId == 1065
		let sKey := "leftarm"
	elseif iTileId == 1067
		let sKey := "rightarm"
	elseif iTileId == 1069
		let sKey := "leftleg"
	elseif iTileId == 1071
		let sKey := "rightleg"
	endif

	if eval !(sKey) || (iPaperDollTreatment < 2)
		let aConfig := Ar_Null
		return
	endif

	array_var aBodyPartHealthMap = Call GetPlayerBodyHealthMapUDF
	short iBodyPartHealth = aBodyPartHealthMap[$sKey]
	
	; Sound

	short bIsValidOption = !(GetUIFloatAlt "StatsMenu/GLOW_BRANCH/stats_status_container/smi_treatment_preview/_failure")
	short bIsInjuredBodyPart = iBodyPartHealth < 100

	Call PlayInteractionSoundUDF (eval bIsValidOption && bIsInjuredBodyPart)

	; Treatment

	if iPaperDollTreatment == 2
		Call OnTriageSelectionConfirmUDF sKey
	else
		Call PerformQuickTreatmentUDF sKey
	endif

	; Clean-Up

	Sv_Destruct sKey

	let aConfig := Ar_Null
	let aBodyPartHealthMap := Ar_Null

end
