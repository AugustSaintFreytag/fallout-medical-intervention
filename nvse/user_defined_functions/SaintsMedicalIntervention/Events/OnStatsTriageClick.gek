begin function { short iMenuId, short iTileId, string_var sTileName }

	; UDFs

	ref GetConfigUDF = CompileScript "SaintsMedicalIntervention\Configuration\GetConfig.gek"
	ref OpenTriageMenuUDF = CompileScript "SaintsMedicalIntervention\Activation\OpenTriageMenu.gek"

	; Config Check

	array_var aConfig = Call GetConfigUDF

	if eval aConfig["iPipBoyDoctorsBagBehavior"] == 0
		let aConfig := Ar_Null
		Player.EquipItemAlt NVDoctorBag 0 0
		return
	endif

	; Open Triage

	Call OpenTriageMenuUDF

	; Clean-Up

	let aConfig := Ar_Null

end
