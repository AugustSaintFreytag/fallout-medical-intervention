begin function { ref rBaseItem, ref rInvRef, short bIsActivationNotPrevented, short iActivatedHotkey }

	; UDFs

	ref GetConfigUDF = CompileScript "SaintsMedicalIntervention\Configuration\GetConfig.gek"
	ref OpenTriageMenuUDF = CompileScript "SaintsMedicalIntervention\Activation\OpenTriageMenu.gek"

	; Item Check

	if eval rBaseItem != NVDoctorBag
		SetFunctionValue 1
		return
	endif

	; Config Check

	array_var aConfig = Call GetConfigUDF

	if eval aConfig["iInventoryDoctorsBagBehavior"] != 1
		let aConfig := Ar_Null
		SetFunctionValue 1
		return
	endif

	; Open Triage

	Call OpenTriageMenuUDF

	; Clean-Up

	let aConfig := Ar_Null
	SetFunctionValue 0

end
