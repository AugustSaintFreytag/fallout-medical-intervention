begin function { short iTreatmentKind, short iItemKind }

	; UDFs

	ref GetTreatmentItemSoundPathUDF = CompileScript "SaintsMedicalIntervention\Treatment\GetTreatmentItemSoundPath.gek"

	; Main

	ref rSound = TempCloneForm UIMenuFocus 1

	SetSoundTraitNumeric rSound 3 -6.0
	SetSoundTraitNumeric rSound 2 10.0

	string_var sSoundPath

	if iTreatmentKind == 1
		let sSoundPath := Call GetTreatmentItemSoundPathUDF iItemKind
	else
		let sSoundPath := "fx\ui\triage\major\"
	endif

	SetSoundSourceFile rSound ($sSoundPath)

	; PrintC "Playing treatment sound '%z'." sSoundPath

	Player.PlaySound rSound 1

end
