begin function { short iOption }

	; UDFs

	ref ClearTreatmentMenuStateUDF = CompileScript "SaintsMedicalIntervention\Treatment\ClearTreatmentMenuState.gek"
	ref OpenTriageMenuUDF = CompileScript "SaintsMedicalIntervention\Activation\OpenTriageMenu.gek"
	ref OpenTreatmentMenuUDF = CompileScript "SaintsMedicalIntervention\Treatment\OpenTreatmentMenu.gek"
	ref GetBodyPartDescriptionUDF = CompileScript "SaintsMedicalIntervention\Status\GetBodyPartDescription.gek"
	ref GetBodyPartHealthDescriptionUDF = CompileScript "SaintsMedicalIntervention\Status\GetBodyPartHealthDescription.gek"
	ref GetPlayerBodyHealthMapUDF = CompileScript "SaintsMedicalIntervention\Status\GetPlayerBodyHealthMap.gek"
	ref HasRequiredTreatmentItemsUDF = CompileScript "SaintsMedicalIntervention\Treatment\HasRequiredTreatmentItems.gek"
	ref GetNameListUDF = CompileScript "SaintsMedicalIntervention\Utility\GetNameList.gek"
	ref PlayTreatmentSoundUDF = CompileScript "SaintsMedicalIntervention\Treatment\PlayTreatmentSound.gek"
	ref PlayTreatmentAnimationUDF = CompileScript "SaintsMedicalIntervention\Treatment\PlayTreatmentAnimation.gek"
	ref OnTreatmentPerformUDF = CompileScript "SaintsMedicalIntervention\Treatment\OnTreatmentPerform.gek"
	ref OnTreatmentCompleteUDF = CompileScript "SaintsMedicalIntervention\Treatment\OnTreatmentComplete.gek"
	ref DecodeTreatmentOptionFromStringUDF = CompileScript "SaintsMedicalIntervention\Treatment\DecodeTreatmentOptionFromString.gek"

	; Options

	array_var aEncodedTreatmentOptions = Player.AuxiliaryVariableGetAsArray "*SMI_TreatmentDialogOptions"
	short iNumTreatmentOptions = Ar_Size aEncodedTreatmentOptions

	; Pre-Check (Selection)

	if iNumTreatmentOptions <= 0
		PrintC "Bailing after treatment menu close, no treatment options available."
		Call ClearTreatmentMenuStateUDF 0
		let aEncodedTreatmentOptions := Ar_Null

		return
	endif

	if iOption == (iNumTreatmentOptions + 1)
		; Cancel
		PrintC "Bailing after treatment menu close, chose to cancel."
		Call ClearTreatmentMenuStateUDF 0
		let aEncodedTreatmentOptions := Ar_Null

		return
	endif

	if iOption == iNumTreatmentOptions
		; Overview
		Call ClearTreatmentMenuStateUDF 0

		CloseActiveMenu
		Call OpenTriageMenuUDF
		
		let aEncodedTreatmentOptions := Ar_Null
		return
	endif

	if eval iOption < 0 || iOption >= iNumTreatmentOptions
		PrintC "Bailing after treatment menu close, selected option %g out of range." iOption

		Call ClearTreatmentMenuStateUDF 0
		let aEncodedTreatmentOptions := Ar_Null

		return
	endif

	; Pre-Check (Treatment)

	string_var sKey = (Player.AuxiliaryVariableGetString "*SMI_TreatmentDialogBodyPartKey")
	string_var sEncodedTreatmentOption = aEncodedTreatmentOptions[iOption]
	array_var aTreatmentOption = Call DecodeTreatmentOptionFromStringUDF sEncodedTreatmentOption

	if eval !sKey || (Ar_Size aTreatmentOption) <= 0
		MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_thinking.dds|The selected treatment is no longer available."
		Call ClearTreatmentMenuStateUDF 0

		Sv_Destruct sKey, sEncodedTreatmentOption
		let aEncodedTreatmentOptions := Ar_Null
		let aTreatmentOption := Ar_Null

		return
	endif

	array_var aTreatmentItems = aTreatmentOption["items"]

	if eval (Ar_Size aTreatmentItems) <= 0
		MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_thinking.dds|The selected treatment is no longer available."
		Call ClearTreatmentMenuStateUDF 0

		Sv_Destruct sKey, sEncodedTreatmentOption
		let aEncodedTreatmentOptions := Ar_Null
		let aTreatmentOption := Ar_Null
		let aTreatmentItems := Ar_Null

		return
	endif

	float fRestoreFactor = aTreatmentOption["restoreFactor"]
	short iRestoreMode = aTreatmentOption["restoreMode"]

	if eval fRestoreFactor < 0 || fRestoreFactor > 1 || (iRestoreMode != 0 && iRestoreMode != 1) || (iRestoreMode == 1 && fRestoreFactor == 0)
		MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_thinking.dds|The selected treatment is no longer available."
		Call ClearTreatmentMenuStateUDF 0
		
		Sv_Destruct sKey, sEncodedTreatmentOption
		let aEncodedTreatmentOptions := Ar_Null
		let aTreatmentOption := Ar_Null
		let aTreatmentItems := Ar_Null
		
		return
	endif

	short bHasRequiredItems = Call HasRequiredTreatmentItemsUDF aTreatmentItems

	if eval !bHasRequiredItems
		Call ClearTreatmentMenuStateUDF 1
		CloseActiveMenu

		Call OpenTreatmentMenuUDF sKey
		MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|You do not have the items required for this treatment."

		Sv_Destruct sKey, sEncodedTreatmentOption
		let aEncodedTreatmentOptions := Ar_Null
		let aTreatmentOption := Ar_Null
		let aTreatmentItems := Ar_Null
		return
	endif

	; Treatment

	string_var sTreatmentItemNames = Call GetNameListUDF aTreatmentItems
	string_var sPartDescription = Sv_ToLower (Call GetBodyPartDescriptionUDF sKey)
	
	array_var aPlayerBodyHealthMap = Call GetPlayerBodyHealthMapUDF
	short iBodyPartHealth = aPlayerBodyHealthMap[$sKey]
	
	string_var sPartHealthDescription = Sv_ToLower (Call GetBodyPartHealthDescriptionUDF sKey iBodyPartHealth)

	; PrintC "Confirmed treatment for limb '%z' with items %z." sKey sTreatmentItemNames

	; Remove Items

	foreach array_var aTreatmentItemElement <- aTreatmentItems
		ref rTreatmentItem = *aTreatmentItemElement
		Player.RemoveItem rTreatmentItem 1 1
	loop

	; Persist Completion Message

	string_var sCompleteMessage = Sv_Construct "interface\icons\pipboyimages\itsmejesushchrist\message icons\glow_doctor.dds|You've used %z to treat your %z %z." sTreatmentItemNames sPartHealthDescription sPartDescription
	
	Player.AuxiliaryVariableSetString "*SMI_TreatmentCompleteMessage" ($sCompleteMessage)
	Player.AuxiliaryVariableSetFloat "*SMI_TreatmentRestoreFactor" (fRestoreFactor)
	Player.AuxiliaryVariableSetFloat "*SMI_TreatmentRestoreMode" (iRestoreMode)

	; Perform Treatment

	PrintC "Confirming treatment for body part '%z' with items '%z'." sKey sTreatmentItemNames

	Call ClearTreatmentMenuStateUDF 1

	Call PlayTreatmentSoundUDF
	Call PlayTreatmentAnimationUDF OnTreatmentPerformUDF OnTreatmentCompleteUDF

	; Clean-Up

	Sv_Destruct sKey, sEncodedTreatmentOption, sTreatmentItemNames, sPartDescription, sPartHealthDescription, sCompleteMessage

	let aEncodedTreatmentOptions := Ar_Null
	let aTreatmentOption := Ar_Null
	let aTreatmentItems := Ar_Null
	let aPlayerBodyHealthMap := Ar_Null

end
