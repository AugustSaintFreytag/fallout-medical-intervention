begin function {}

	; UDFs

	ref RestoreAllBodyPartsBySkillUDF = CompileScript "SaintsMedicalIntervention\Status\RestoreAllBodyPartsBySkill.gek"
	ref RestoreBodyPartByItemUDF = CompileScript "SaintsMedicalIntervention\Status\RestoreBodyPartByItem.gek"
	ref RestoreBodyPartBySkillUDF = CompileScript "SaintsMedicalIntervention\Status\RestoreBodyPartBySkill.gek"

	; Main

	string_var sKey = (Player.AuxiliaryVariableGetString "*SMI_TreatmentDialogBodyPartKey")
	float fRestoreFactor = (Player.AuxiliaryVariableGetFloat "*SMI_TreatmentRestoreFactor")
	short iRestoreMode = (Player.AuxiliaryVariableGetFloat "*SMI_TreatmentRestoreMode")

	if eval iRestoreMode == 0 && sKey == "all"
		Call RestoreAllBodyPartsBySkillUDF fRestoreFactor
	elseif eval iRestoreMode == 0 && sKey
		Call RestoreBodyPartBySkillUDF sKey fRestoreFactor
	elseif eval iRestoreMode == 1 && sKey && sKey != "all"
		Call RestoreBodyPartByItemUDF sKey fRestoreFactor
	endif

	; Clean-Up

	Player.AuxiliaryVariableErase "*SMI_TreatmentDialogBodyPartKey"
	Player.AuxiliaryVariableErase "*SMI_TreatmentRestoreFactor"
	Player.AuxiliaryVariableErase "*SMI_TreatmentRestoreMode"
	Sv_Destruct sKey

end
