begin function { string_var sKey }

	; UDFs

	ref OpenTriageMenuUDF = CompileScript "SaintsMedicalIntervention\Activation\OpenTriageMenu.gek"
	ref OpenTreatmentMenuUDF = CompileScript "SaintsMedicalIntervention\Activation\OpenTreatmentMenu.gek"
	ref GetTreatmentSkillLevelUDF = CompileScript "SaintsMedicalIntervention\Treatment\GetTreatmentSkillLevel.gek"
	ref GetBodyPartConcernDescriptionUDF = CompileScript "SaintsMedicalIntervention\Status\GetBodyPartConcernDescription.gek"
	ref GetPlayerBodyHealthMapUDF = CompileScript "SaintsMedicalIntervention\Status\GetPlayerBodyHealthMap.gek"

	; Validation

	short bIsValidKey = eval sKey == "head" || sKey == "torso" || sKey == "leftarm" || sKey == "rightarm" || sKey == "leftleg" || sKey == "rightleg" || sKey == "all"

	if eval !bIsValidKey
		PrintC "Cannot confirm triage selection with invalid key '%z'." sKey
		return
	endif

	; Preconditions

	short bFromOverview = MenuMode 1001
	short bPlayerHasDoctorsBag = eval (Player.GetItemCount NVDoctorBag) > 0

	if eval !bPlayerHasDoctorsBag
		if eval bFromOverview
			CloseActiveMenu
			Call OpenTriageMenuUDF
		endif

		MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|You need a Doctor's Bag to perform field treatment."
		return
	endif

	array_var aPlayerBodyHealthMap = Call GetPlayerBodyHealthMapUDF
	short iBodyPartHealth = aPlayerBodyHealthMap[$sKey]
	short bBodyPartIsHealthy = eval sKey != "all" && iBodyPartHealth > 0
	short iRequiredSkill = Call GetTreatmentSkillLevelUDF sKey bBodyPartIsHealthy
	short iCurrentSkill = Player.GetActorValue Medicine

	if eval iCurrentSkill < iRequiredSkill
		string_var sPartConcernDescription = Call GetBodyPartConcernDescriptionUDF sKey

		if eval bFromOverview
			CloseActiveMenu
			Call OpenTriageMenuUDF
		endif

		MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|You cannot treat %z with your current Medicine skill (%g/%g)." sPartConcernDescription iCurrentSkill iRequiredSkill

		Sv_Destruct sPartConcernDescription
		let aPlayerBodyHealthMap := Ar_Null
		return
	endif

	; Open Treatment

	Player.AuxiliaryVariableSetString "*SMI_TreatmentDialogBodyPartKey" ($sKey)

	if eval bFromOverview
		CloseActiveMenu
	endif

	Call OpenTreatmentMenuUDF sKey

	; Clean-Up

	let aPlayerBodyHealthMap := Ar_Null

end
