begin function { short iOption }

	; UDFs

	ref OnTriageSelectionConfirmUDF = CompileScript "SaintsMedicalIntervention\Activation\OnTriageSelectionConfirm.gek"

	; Main

	array_var aBodyPartKeys = (Player.AuxiliaryVariableGetAsArray "*SMI_TreatmentDialogBodyParts")
	short iNumBodyParts = (Ar_Size aBodyPartKeys)

	if eval iOption < 0 || iOption >= iNumBodyParts
		let aBodyPartKeys := Ar_Null
		return
	endif

	string_var sKey = aBodyPartKeys[iOption]
	Call OnTriageSelectionConfirmUDF sKey

	; Clean-Up

	Sv_Destruct sKey
	let aBodyPartKeys := Ar_Null

end
