begin function { string_var sKey, short bIsMinor }

	short iRequiredSkill

	if eval sKey == "all"
		let iRequiredSkill := 20
	elseif eval sKey == "head"
		let iRequiredSkill := 80
	elseif eval sKey == "torso"
		let iRequiredSkill := 60
	elseif eval (sKey == "leftarm" || sKey == "rightarm")
		let iRequiredSkill := 40
	elseif eval (sKey == "leftleg" || sKey == "rightleg")
		let iRequiredSkill := 30
	else
		let iRequiredSkill := 0
	endif

	if eval bIsMinor && sKey != "all"
		let iRequiredSkill := iRequiredSkill / 2
	endif

	SetFunctionValue iRequiredSkill

end
