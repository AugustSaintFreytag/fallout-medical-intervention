begin function { string_var sKey, short iBodyPartHealth, short iPlayerSkill, short iMinSkill, short iShowBodyPartHealth, short bShowBodyPartHealthEmphasis, short iShowSkillRequirements }

	; UDFs

	ref GetBodyPartDescriptionUDF = CompileScript "SaintsMedicalIntervention\Status\GetBodyPartDescription.gek"
	ref GetBodyPartHealthDescriptionUDF = CompileScript "SaintsMedicalIntervention\Status\GetBodyPartHealthDescription.gek"
	ref GetTreatmentSkillRequirementBlockUDF = CompileScript "SaintsMedicalIntervention\Treatment\GetTreatmentSkillRequirementBlock.gek"

	; Main

	string_var sPartDescription = Call GetBodyPartDescriptionUDF sKey

	if eval sKey == "all"
		let sPartDescription := "All Body Parts"
	endif

	string_var sSkillBlock = Call GetTreatmentSkillRequirementBlockUDF iPlayerSkill iMinSkill iShowSkillRequirements
	string_var sText = ""
	string_var sPartHealthDescription = ""

	if eval sSkillBlock
		let sText := Sv_Construct "%z %z" sSkillBlock sPartDescription
	else
		let sText := Sv_Construct "%z" sPartDescription
	endif

	if iShowBodyPartHealth > 0
		let sPartHealthDescription := Call GetBodyPartHealthDescriptionUDF sKey iBodyPartHealth

		if iShowBodyPartHealth == 3
			let sPartHealthDescription := Sv_Construct "%z, %g%%" sPartHealthDescription iBodyPartHealth
		elseif iShowBodyPartHealth == 2
			let sPartHealthDescription := Sv_Construct "%g%%" iBodyPartHealth
		endif

		if eval bShowBodyPartHealthEmphasis && sKey != "all" && iBodyPartHealth == 0
			let sPartHealthDescription := "*" + sPartHealthDescription + "*"
		endif

		let sText += " (" + sPartHealthDescription + ")"
	endif

	SetFunctionValue sText

	; Clean-Up

	Sv_Destruct sPartDescription, sPartHealthDescription, sSkillBlock, sText

end
