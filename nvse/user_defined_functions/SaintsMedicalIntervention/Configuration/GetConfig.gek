begin function {}

	; MCM writes directly to this file. Reload the cache so changes are visible
	; on the next interaction, while retaining default-aware reads.
	ReloadIniCache "SaintsMedicalIntervention.ini"

	array_var aConfig = Ar_Construct "stringmap"

	let aConfig["iPipBoyPaperDollTreatment"] := Clamp (GetINIFloat_Cached "PipBoy:iPipBoyPaperDollTreatment" "SaintsMedicalIntervention.ini" 3) 0 3
	let aConfig["bPipBoyPaperDollTreatmentPreview"] := eval GetINIFloat_Cached "PipBoy:bPipBoyPaperDollTreatmentPreview" "SaintsMedicalIntervention.ini" 1
	let aConfig["iPipBoyDoctorsBagBehavior"] := Clamp (GetINIFloat_Cached "PipBoy:iPipBoyDoctorsBagBehavior" "SaintsMedicalIntervention.ini" 1) 0 1
	let aConfig["iInventoryDoctorsBagBehavior"] := Clamp (GetINIFloat_Cached "PipBoy:iInventoryDoctorsBagBehavior" "SaintsMedicalIntervention.ini" 0) 0 1

	let aConfig["bShowOnlyCrippledBodyParts"] := eval GetINIFloat_Cached "TriageMenu:bShowOnlyCrippledBodyParts" "SaintsMedicalIntervention.ini" 0
	let aConfig["iShowBodyPartHealth"] := Clamp (GetINIFloat_Cached "TriageMenu:iShowBodyPartHealth" "SaintsMedicalIntervention.ini" 2) 0 3
	let aConfig["bShowBodyPartHealthEmphasis"] := eval GetINIFloat_Cached "TriageMenu:bShowBodyPartHealthEmphasis" "SaintsMedicalIntervention.ini" 1
	let aConfig["iShowSkillRequirements"] := Clamp (GetINIFloat_Cached "TriageMenu:iShowSkillRequirements" "SaintsMedicalIntervention.ini" 1) 0 2

	let aConfig["iShowItemNumRequirements"] := Clamp (GetINIFloat_Cached "TreatmentMenu:iShowItemNumRequirements" "SaintsMedicalIntervention.ini" 0) 0 2

	let aConfig["fMaxRestoreFactor"] := Clamp (GetINIFloat_Cached "Treatment:fMaxRestoreFactor" "SaintsMedicalIntervention.ini" 0.85) 0 1
	let aConfig["bShowAnimationForMajorTreatment"] := eval GetINIFloat_Cached "Treatment:bShowAnimationForMajorTreatment" "SaintsMedicalIntervention.ini" 1
	let aConfig["bShowAnimationForMinorTreatment"] := eval GetINIFloat_Cached "Treatment:bShowAnimationForMinorTreatment" "SaintsMedicalIntervention.ini" 0
	let aConfig["fSleepRestorationFactor"] := Clamp (GetINIFloat_Cached "Treatment:fSleepRestorationFactor" "SaintsMedicalIntervention.ini" 0.05) 0 1

	SetFunctionValue aConfig

end
